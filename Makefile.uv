.DEFAULT_GOAL=help

# Required for globs to work correctly
SHELL:=/bin/bash

.PHONY: all
all: dev format lint test  ## Build all common targets

.PHONY: format
format:  ## Format all python code and apply safe lint fixes
	@echo "==> Formatting all python code"
	@uv run --locked ruff format .
	@uv run --locked ruff check --fix .

.PHONY: lint
lint:  ## Run static code analysis
	@echo "==> Running static code analysis"
	@echo "==> Running ruff format --check ..."
	@uv run --locked ruff format --check .
	@echo "==> Running ruff check ..."
	@uv run --locked ruff check .
	@echo "==> Running mypy ..."
	@uv run --locked mypy .

.PHONY: dev
dev:  ## Install the development environment (.venv) from uv.lock
	@echo "==> Installing the development environment"
	@uv sync --dev --locked

.PHONY: lock
lock:  ## Re-resolve uv.lock after changing pyproject.toml
	@echo "==> Re-resolving uv.lock"
	@uv lock

.PHONY: test
test:  ## Run unit tests
	@echo "==> Running unit tests"
	@uv run --locked pytest

.PHONY: check
check: lint test  ## Lint and test without changing files (for CI)

.PHONY: clean
clean:  ## clean up temporary files
	@echo "==> Removing temporary files from build and test"
	@# purposely deal with .venv under current dir to avoid excessive redo venv
	@for TEMP in .venv .coverage .mypy_cache .pytest_cache .ruff_cache __pycache__ build ; do \
		find . -name $${TEMP} | xargs rm -rf ; \
	done

.PHONY: help
help:  ## Print list of Makefile targets
	@grep -E '^[a-zA-Z0-9_-]+:.*?## .*$$' $(MAKEFILE_LIST) | \
	  cut -d ":" -f1- | \
	  awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-30s\033[0m %s\n", $$1, $$2}'
